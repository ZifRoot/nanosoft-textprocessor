<Window x:Class="TextProcessor.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nanosoft TextProcessor" Width="1100" Height="800" MinWidth="900" MinHeight="650">
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <GroupBox Header="Файлы" Grid.Row="0" Margin="0,0,0,8">
      <Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DataGrid x:Name="JobsGrid" ItemsSource="{Binding Jobs}" AutoGenerateColumns="False" CanUserAddRows="False" Height="145">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Входной файл" Binding="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            <DataGridTextColumn Header="Выходной файл" Binding="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            <DataGridComboBoxColumn Header="Кодировка" SelectedItemBinding="{Binding Encoding}" ItemsSource="{Binding DataContext.EncodingKinds, RelativeSource={RelativeSource AncestorType=Window}}" Width="130"/>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="+" Width="35" Click="AddJob_Click"/>
          <Button Content="-" Width="35" Margin="5,0,0,0" Click="RemoveJob_Click"/>
          <Button Content="Выбрать входной файл" Margin="15,0,0,0" Click="SelectInput_Click"/>
          <Button Content="Выбрать выходной файл" Margin="5,0,0,0" Click="SelectOutput_Click"/>
        </StackPanel>
      </Grid>
    </GroupBox>

    <GroupBox Header="Параметры обработки" Grid.Row="1" Margin="0,0,0,8">
      <Grid Margin="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="220"/><ColumnDefinition Width="180"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="Минимальная длина:" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding MinWordLength}" Margin="3"/>
        <CheckBox Grid.Column="2" Content="Удалять пунктуацию" IsChecked="{Binding RemovePunctuation}" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="3" ItemsSource="{Binding PunctuationModes}" SelectedItem="{Binding PunctuationHandling}" Margin="3"/>
        <TextBlock Grid.Row="1" Text="Набор пунктуации:" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PunctuationSet}" Margin="3"/>
        <CheckBox Grid.Row="1" Grid.Column="2" Content="Цифры — часть слова" IsChecked="{Binding KeepDigits}"/>
        <CheckBox Grid.Row="1" Grid.Column="3" Content="Дефис — часть слова" IsChecked="{Binding KeepHyphen}"/>
        <CheckBox Grid.Row="2" Grid.Column="2" Content="Апостроф — часть слова" IsChecked="{Binding KeepApostrophe}"/>
        <TextBlock Grid.Row="2" Text="Доп. символы слова:" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AdditionalWordChars}" Margin="3"/>
        <TextBlock Grid.Row="3" Text="Пробелы:" VerticalAlignment="Center"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding WhitespaceModes}" SelectedItem="{Binding WhitespaceNormalization}" Margin="3"/>
        <CheckBox Grid.Row="3" Grid.Column="2" Content="Сохранять переносы" IsChecked="{Binding PreserveLineBreaks}"/>
        <TextBlock Grid.Row="4" Text="Шаблон имени:" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Template}" Margin="3"/>
        <TextBlock Grid.Row="4" Grid.Column="2" Text="Суффикс:" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Suffix}" Margin="3"/>
        <TextBlock Grid.Row="5" Text="Параллелизм:" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Parallelism}" Margin="3"/>
      </Grid>
    </GroupBox>

    <GroupBox Header="Прогресс и журнал" Grid.Row="2">
      <Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ProgressBar Height="22" Minimum="0" Maximum="100" Value="{Binding Progress}"/>
        <TextBlock Grid.Row="1" Margin="0,6" Text="{Binding CurrentFile}"/>
        <ListBox Grid.Row="2" ItemsSource="{Binding Log}"/>
      </Grid>
    </GroupBox>

    <DockPanel Grid.Row="3" Margin="0,8,0,0">
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Запустить обработку" Width="160" Margin="5,0" Command="{Binding StartCommand}"/>
        <Button Content="Отмена" Width="90" Command="{Binding CancelCommand}"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>